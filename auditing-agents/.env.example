# Copy this file to .env and fill in values.
# The auditing agent calls Anthropic (Claude) for both the investigator agent
# and the quirk scorer. Target-model inference goes through a locally-served
# vLLM / tokasaurus endpoint (see README).

# REQUIRED — Anthropic key used by the auditing agent (run_all_agents.py).
ANTHROPIC_API_KEY=

# REQUIRED — read by src/__init__.py via safety-tooling's setup_environment.
# In practice you can set this to the same value as ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY_HIGH_PRIO=

# Dummy, but must be non-empty: safety-tooling's setup_environment calls
# openai_tag="OPENAI_API_KEY" and its client init will crash without a value.
# Not used by the canonical audit flow.
OPENAI_API_KEY=sk-dummy-not-used
